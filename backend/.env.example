# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# ── Groq (AI chatbot) ─────────────────────────────────────────────────────────
# Free tier is sufficient — get key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# ── Admin ─────────────────────────────────────────────────────────────────────
# Comma-separated email addresses with admin dashboard access
ADMIN_EMAILS=your@email.com

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins (use * for development)
FRONTEND_ORIGINS=http://localhost:5173

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" to disable /docs and /redoc
ENV=development
